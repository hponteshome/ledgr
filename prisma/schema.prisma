/// Cabecalho da folha mensal por empresa/competencia
model FolhaMensal {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  competencia String      @map("competencia") @db.VarChar(7) // AAAA-MM
  status      StatusFolha @default(ABERTA) @map("status")

  // Totalizadores
  totalBruto           Decimal @default(0) @map("total_bruto") @db.Decimal(15, 2)
  totalDescontos       Decimal @default(0) @map("total_descontos") @db.Decimal(15, 2)
  totalLiquido         Decimal @default(0) @map("total_liquido") @db.Decimal(15, 2)
  totalFgts            Decimal @default(0) @map("total_fgts") @db.Decimal(15, 2)
  totalInssEmpregado   Decimal @default(0) @map("total_inss_empregado") @db.Decimal(15, 2)
  totalInssEmpregador  Decimal @default(0) @map("total_inss_empregador") @db.Decimal(15, 2)
  totalIrrf            Decimal @default(0) @map("total_irrf") @db.Decimal(15, 2)
  totalSindical        Decimal @default(0) @map("total_sindical") @db.Decimal(15, 2)

  // Contas contabeis para lancamento automatico
  contaSalariosId       String? @map("conta_salarios_id") @db.Uuid
  contaFgtsId           String? @map("conta_fgts_id") @db.Uuid
  contaInssEmpregadoId  String? @map("conta_inss_empregado_id") @db.Uuid
  contaInssEmpregadorId String? @map("conta_inss_empregador_id") @db.Uuid
  contaIrrfId           String? @map("conta_irrf_id") @db.Uuid
  contaSindicalId       String? @map("conta_sindical_id") @db.Uuid
  contaFeriasId         String? @map("conta_ferias_id") @db.Uuid
  contaDecimoId         String? @map("conta_decimo_id") @db.Uuid

  // Integracao
  journalEntryId String?   @map("journal_entry_id") @db.Uuid
  geradoEm       DateTime? @map("gerado_em") @db.Timestamp(6)
  fechadoEm      DateTime? @map("fechado_em") @db.Timestamp(6)
  pagoEm         DateTime? @map("pago_em") @db.Timestamp(6)

  observacao  String?   @map("observacao") @db.Text
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(6)

  company      Company            @relation(fields: [companyId], references: [id])
  funcionarios FolhaFuncionario[]

  @@unique([companyId, competencia])
  @@index([companyId, status])
  @@map("folhas_mensais")
}

/// Linha da folha por funcionario — todos os calculos detalhados
model FolhaFuncionario {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folhaId     String       @map("folha_id") @db.Uuid
  employeeId  String       @map("employee_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  tipoContrato TipoContrato @default(CLT) @map("tipo_contrato")

  // ── Proventos ────────────────────────────────────────────────────────────────
  salarioBase             Decimal @default(0) @map("salario_base") @db.Decimal(15, 2)
  diasTrabalhados         Int     @default(30) @map("dias_trabalhados")
  horasExtrasFifty        Decimal @default(0) @map("horas_extras_50") @db.Decimal(8, 2)
  vrHorasExtrasFifty      Decimal @default(0) @map("vr_horas_extras_50") @db.Decimal(15, 2)
