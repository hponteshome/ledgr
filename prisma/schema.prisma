  mesRecolhSindical String? @map("mes_recolh_sindical") @db.VarChar(7) // AAAA-MM

  // ── Dissidio ─────────────────────────────────────────────────────────────────
  percentualDissidio   Decimal?  @map("percentual_dissidio") @db.Decimal(5, 4)
  dataVigenciaDissidio DateTime? @map("data_vigencia_dissidio") @db.Date
  salarioAnterior      Decimal?  @map("salario_anterior") @db.Decimal(15, 2)

  // ── Beneficios ───────────────────────────────────────────────────────────────
  vrValeTransporte Decimal @default(0) @map("vr_vale_transporte") @db.Decimal(15, 2)
  vrValeRefeicao   Decimal @default(0) @map("vr_vale_refeicao") @db.Decimal(15, 2)
  vrValeAlimentacao Decimal @default(0) @map("vr_vale_alimentacao") @db.Decimal(15, 2)
  vrPlanoSaude     Decimal @default(0) @map("vr_plano_saude") @db.Decimal(15, 2)
  vrPlanoOdonto    Decimal @default(0) @map("vr_plano_odonto") @db.Decimal(15, 2)
  vrSeguroVida     Decimal @default(0) @map("vr_seguro_vida") @db.Decimal(15, 2)
  vrOutrosDescontos Decimal @default(0) @map("vr_outros_descontos") @db.Decimal(15, 2)

  // ── Totais ───────────────────────────────────────────────────────────────────
  totalDescontos Decimal @default(0) @map("total_descontos") @db.Decimal(15, 2)
  totalLiquido   Decimal @default(0) @map("total_liquido") @db.Decimal(15, 2)

  // ── Integracao ───────────────────────────────────────────────────────────────
  journalEntryId String?   @map("journal_entry_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  folha    FolhaMensal     @relation(fields: [folhaId], references: [id])
