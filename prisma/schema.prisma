/// Funcionários vinculados a empresas — eSocial S-2200 ready.
model Employee {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  personId  String? @map("person_id") @db.Uuid

  // ── Dados Pessoais ─────────────────────────────────────────
  fullName       String          @map("full_name") @db.VarChar
  nickname       String?         @map("nickname") @db.VarChar
  taxId          String          @map("tax_id") @db.VarChar(11)
  motherName     String?         @map("mother_name") @db.VarChar
  fatherName     String?         @map("father_name") @db.VarChar
  birthDate      DateTime        @map("birth_date") @db.Date
  birthCity      String?         @map("birth_city") @db.VarChar
  birthState     String?         @map("birth_state") @db.VarChar(2)
  nationality    String?         @default("10") @map("nationality") @db.VarChar(3)
  raceColor      RaceColor?      @map("race_color")
  maritalStatus  String?         @map("marital_status") @db.VarChar(20)
  educationLevel EducationLevel? @map("education_level")
  hasDisability  Boolean         @default(false) @map("has_disability")
  phone          String?         @map("phone") @db.VarChar(20)
  cellPhone      String?         @map("cell_phone") @db.VarChar(20)

  // ── Endereço ───────────────────────────────────────────────
  street       String? @map("street") @db.VarChar
