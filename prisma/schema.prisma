  cnhNumber    String?   @map("cnh_number") @db.VarChar(20)

  // ── Dados Funcionais ───────────────────────────────────────
  registrationNumber String?   @map("registration_number") @db.VarChar(20)
  hireDate           DateTime  @map("hire_date") @db.Date
  terminationDate    DateTime? @map("termination_date") @db.Date
  experienceDays     Int?      @map("experience_days")
  role               String    @map("role") @db.VarChar
  salary             Decimal   @map("salary") @db.Decimal(15, 2)
  weeklyHours        Decimal?  @map("weekly_hours") @db.Decimal(5, 2)
  department         String?   @map("department") @db.VarChar
  lotacao            String?   @map("lotacao") @db.VarChar
  workSchedule       Json?     @map("work_schedule") @db.Json

  // ── eSocial / GFIP ─────────────────────────────────────────
  employmentBond EmploymentBond? @map("employment_bond")
  gfipCategory   GfipCategory?   @map("gfip_category")
