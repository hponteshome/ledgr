/// Codigos de aglutinacao RFB por leiaute e ano-base.
/// Populados via POST /sped/rfb-codes/import (JSON).
model RfbAglutinationCode {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leiaute   Int     @map("leiaute")
  anoBase   Int     @map("ano_base")
  tipo      String  @map("tipo") @db.VarChar(3) // BP | DRE
  codigo    String  @map("codigo") @db.VarChar(20)
  descricao String  @map("descricao") @db.VarChar(200)
  nivel     Int     @map("nivel")
  codigoPai String? @map("codigo_pai") @db.VarChar(20)
  ordem     Int     @map("ordem")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([leiaute, anoBase, tipo, codigo])
  @@index([leiaute, anoBase, tipo])
  @@map("rfb_aglutination_codes")
}

/// Visao Contabil por empresa e exercicio (BP ou DRE).
model AccountingView {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String  @map("name") @db.VarChar(100)
  tipo      String  @map("tipo") @db.VarChar(3) // BP | DRE
  leiaute   Int     @map("leiaute")
  anoBase   Int     @map("ano_base")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  company  Company                 @relation(fields: [companyId], references: [id])
  mappings AccountingViewMapping[]

  @@unique([companyId, tipo, anoBase])
  @@index([companyId, isActive])
  @@map("accounting_views")
}

/// Mapeamento conta analitica -> codigo de aglutinacao RFB (= registro I052 do ECD).
model AccountingViewMapping {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewId           String @map("view_id") @db.Uuid
  accountId        String @map("account_id") @db.Uuid
  aglutinationCode String @map("aglutination_code") @db.VarChar(20)
  ordem            Int    @default(0) @map("ordem")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  view    AccountingView  @relation(fields: [viewId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [accountId], references: [id])

  @@unique([viewId, accountId])
  @@index([viewId])
  @@index([accountId])
  @@map("accounting_view_mappings")
}

// =============================================================================
// OBRIGAÇÕES FISCAIS
// =============================================================================

enum FiscalObligationStatus {
  PENDING
  IN_PROGRESS
  DONE
  OVERDUE
}

/// Obrigações fiscais e acessórias por empresa/competência.
/// Geradas automaticamente pelo sistema com base no regime tributário.
/// Competência mensal: YYYY-MM. Competência anual: YYYY.
model FiscalObligation {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String                 @map("company_id") @db.Uuid
  code        String                 @map("code") @db.VarChar(30)
  competence  String                 @map("competence") @db.VarChar(7)
  dueDate     DateTime               @map("due_date") @db.Date
  status      FiscalObligationStatus @default(PENDING) @map("status")
  notes       String?                @map("notes") @db.Text
  doneAt      DateTime?              @map("done_at") @db.Timestamp(6)
  doneById    String?                @map("done_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  company  Company @relation(fields: [companyId], references: [id])
  doneBy   User?   @relation("ObrigacaoDoneBy", fields: [doneById], references: [id])

  @@unique([companyId, code, competence])
  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@map("fiscal_obligations")
}

