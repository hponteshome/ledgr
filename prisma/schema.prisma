enum HolidayType {
  NACIONAL
  ESTADUAL
  MUNICIPAL
  JUDAICO
  FACULTATIVO

  @@map("holiday_type")
}

model Holiday {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime    @map("date") @db.Date
