  competencia String @map("competencia") @db.VarChar(7)

  valor       Decimal                  @map("valor") @db.Decimal(15, 2)
  valorPis    Decimal                  @default(0) @map("valor_pis") @db.Decimal(15, 2)
  valorCofins Decimal                  @default(0) @map("valor_cofins") @db.Decimal(15, 2)
  status      StatusProvisaoLancamento @default(PROVISIONADO) @map("status")
  valorCsll   Decimal                  @default(0) @map("valor_csll") @db.Decimal(15, 2)
  valorIrpj   Decimal                  @default(0) @map("valor_irpj") @db.Decimal(15, 2)

  // Placeholder NF
  nfNumero      String?   @map("nf_numero") @db.VarChar
  nfChave       String?   @map("nf_chave") @db.VarChar(44)
  nfConferida   Boolean   @default(false) @map("nf_conferida")
