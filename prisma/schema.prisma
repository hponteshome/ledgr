  vrHorasExtrasHundred    Decimal @default(0) @map("vr_horas_extras_100") @db.Decimal(15, 2)
  adicionalNoturno        Decimal @default(0) @map("adicional_noturno") @db.Decimal(15, 2)
  adicionalPericulosidade Decimal @default(0) @map("adicional_periculosidade") @db.Decimal(15, 2)
  adicionalInsalubridade  Decimal @default(0) @map("adicional_insalubridade") @db.Decimal(15, 2)
  ferias                  Decimal @default(0) @map("ferias") @db.Decimal(15, 2)
  tercoFerias             Decimal @default(0) @map("terco_ferias") @db.Decimal(15, 2)
  decimoTerceiro          Decimal @default(0) @map("decimo_terceiro") @db.Decimal(15, 2)
  adiantamento            Decimal @default(0) @map("adiantamento") @db.Decimal(15, 2)
  outrosProventos         Decimal @default(0) @map("outros_proventos") @db.Decimal(15, 2)
  totalBruto              Decimal @default(0) @map("total_bruto") @db.Decimal(15, 2)

  // ── INSS Empregado ───────────────────────────────────────────────────────────
  baseInss    Decimal @default(0) @map("base_inss") @db.Decimal(15, 2)
  aliqInss    Decimal @default(0) @map("aliq_inss") @db.Decimal(5, 4)
  valorInss   Decimal @default(0) @map("valor_inss") @db.Decimal(15, 2)

  // ── INSS Patronal ────────────────────────────────────────────────────────────
  aliqInssEmpregador  Decimal @default(0) @map("aliq_inss_empregador") @db.Decimal(5, 4)
  valorInssEmpregador Decimal @default(0) @map("valor_inss_empregador") @db.Decimal(15, 2)
  aliqRat             Decimal @default(0) @map("aliq_rat") @db.Decimal(5, 4) // RAT ajustado
  valorRat            Decimal @default(0) @map("valor_rat") @db.Decimal(15, 2)
  aliqTerceiros       Decimal @default(0) @map("aliq_terceiros") @db.Decimal(5, 4) // Sistema S
  valorTerceiros      Decimal @default(0) @map("valor_terceiros") @db.Decimal(15, 2)

  // ── IRRF ────────────────────────────────────────────────────────────────────
  baseIrrf           Decimal @default(0) @map("base_irrf") @db.Decimal(15, 2)
  deducaoDependentes Decimal @default(0) @map("deducao_dependentes") @db.Decimal(15, 2)
  numDependentes     Int     @default(0) @map("num_dependentes")
  aliqIrrf           Decimal @default(0) @map("aliq_irrf") @db.Decimal(5, 4)
  deducaoIrrf        Decimal @default(0) @map("deducao_irrf") @db.Decimal(15, 2)
  valorIrrf          Decimal @default(0) @map("valor_irrf") @db.Decimal(15, 2)

  // ── FGTS ────────────────────────────────────────────────────────────────────
  baseFgts  Decimal @default(0) @map("base_fgts") @db.Decimal(15, 2)
  aliqFgts  Decimal @default(8) @map("aliq_fgts") @db.Decimal(5, 4) // 8% CLT, 2% estagiario
  valorFgts Decimal @default(0) @map("valor_fgts") @db.Decimal(15, 2)

